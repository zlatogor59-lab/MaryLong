{
  "name": "consultant-nutrition-server",
  "version": "0.1.0",
  "private": true,
  "description": "Серверный контур приложения для консультантов",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:prod": "prisma migrate deploy && node dist/main.js",
    "smoke:production": "node scripts/smoke-production.mjs",
    "start:dev": "nest start --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser:catalog": "node test/catalog-admin.browser.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy"
    ,"fat-profiles:check": "node scripts/run-food-catalog-operation.mjs import-fat-profiles",
    "carbohydrate-context:check": "node scripts/run-food-catalog-operation.mjs import-carbohydrate-context",
    "carbohydrate-quality:check": "node scripts/run-food-catalog-operation.mjs import-carbohydrate-quality",
    "food-products:seed-local": "node scripts/run-food-catalog-operation.mjs seed-local",
    "food-products:sync-seafood": "node scripts/run-food-catalog-operation.mjs sync-seafood",
    "food-products:sync-dairy-eggs-fat": "node scripts/run-food-catalog-operation.mjs sync-dairy-eggs-fat",
    "food-products:sync-processed-meat": "node scripts/run-food-catalog-operation.mjs sync-processed-meat",
    "food-products:sync-salt-coffee": "node scripts/run-food-catalog-operation.mjs sync-salt-coffee",
    "food-products:sync-photo-001": "node scripts/run-food-catalog-operation.mjs sync-photo-001-products"
    ,"food-products:sync-photo-001-minerals": "node scripts/run-food-catalog-operation.mjs sync-photo-001-minerals",
    "food-products:sync-photo-001-vitamins": "node scripts/run-food-catalog-operation.mjs sync-photo-001-vitamins"
    ,"food-products:audit-ua": "node scripts/audit-ukrainian-food-catalog.mjs"
    ,"food-products:sync-ua-priority": "node scripts/run-food-catalog-operation.mjs sync-ua-priority"
    ,"food-products:audit-versions": "node scripts/audit-food-product-card-versions.mjs"
    ,"food-products:verify": "node scripts/verify-food-catalog.mjs"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@10.15.0",
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "^6.14.0",
    "express": "^5.2.1",
    "jose": "^6.0.13",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "prisma": "^6.14.0",
    "supertest": "^7.1.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
