  activity         FatActivity
  energyPercentMin Int         @map("energy_percent_min")
  energyPercentMax Int         @map("energy_percent_max")
  targetMinG       Decimal     @map("target_min_g") @db.Decimal(7, 1)
  targetMaxG       Decimal     @map("target_max_g") @db.Decimal(7, 1)
  gramsPerKgMin    Decimal     @map("grams_per_kg_min") @db.Decimal(5, 2)
  gramsPerKgMax    Decimal     @map("grams_per_kg_max") @db.Decimal(5, 2)
  reasonCiphertext Bytes       @map("reason_ciphertext")
  version          Int         @default(1)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime    @default(now()) @map("updated_at") @db.Timestamptz

  @@map("fat_targets")
}

